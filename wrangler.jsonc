/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "temp-mail",
  "main": "src/index.ts",
  "account_id": "f1ed820de1a2fe3a9abaf1026bedcb10",
  "compatibility_date": "2025-12-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "temp-mail-emails",
      "database_id": "2ac83813-ede7-4c90-8111-3374b3dffdd1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EMAIL_STATS_KV",
      "id": "8bcebdbd251a47ea8cc06cf9d8767480"
    }
  ],
  "routes": [
    {
      "pattern": "tm.603060.xyz",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}